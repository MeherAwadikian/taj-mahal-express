# =============================================================================
# Taj Mahal Express — Environment Variables
# Copy to .env.local for local development. Never commit .env.local.
# =============================================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # server only — never expose

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret               # server only
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret            # server only

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Notifications
MSG91_AUTH_KEY=your-msg91-auth-key
RESEND_API_KEY=re_xxxxxxxxxxxx

# Cloudflare Access (admin subdomain protection)
CF_ACCESS_CLIENT_ID=your-cf-access-client-id
CF_ACCESS_CLIENT_SECRET=your-cf-access-client-secret

# FingerprintJS (fraud detection)
NEXT_PUBLIC_FINGERPRINTJS_API_KEY=your-public-fpjs-key
FINGERPRINTJS_SECRET_API_KEY=your-secret-fpjs-key      # server only

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Cron (generate with: openssl rand -hex 32)
CRON_SECRET=your-random-secret-here

# Supabase DB direct URL (for migrations in CI)
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_ACCESS_TOKEN=your-supabase-access-token
